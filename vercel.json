{
  "build": {
    "env": {
      "CI": "false",
      "DISABLE_ESLINT_PLUGIN": "true",
      "GENERATE_SOURCEMAP": "false"
    }
  },
  "rewrites": [
    { "source": "/tracking/:path*", "destination": "/index.html" },
    { "source": "/((?!api|static|.*\\..*).*)", "destination": "/index.html" }
  ]
}
