# ==============================================================================
# Tracking Distribuidora Sarego — variables de entorno
# ==============================================================================
#
# Copia este archivo como .env.local y rellena los valores.
# .env.local NO se sube al repositorio: contiene credenciales.
#
# En Vercel estas mismas variables se cargan en
#   Settings -> Environment Variables
#
# Las que empiezan por REACT_APP_ quedan DENTRO del paquete que se descarga en
# el navegador: son públicas de hecho. Nunca pongas ahí una contraseña ni un
# secreto. Las demás solo existen en el servidor.
#
# Marcadas [OBLIGATORIA] son las que impiden que la aplicación funcione.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. FIREBASE — sesión de usuarios y datos de la operación
# ------------------------------------------------------------------------------
# Todas [OBLIGATORIAS]. Sin ellas la aplicación NO puede autenticar y se niega
# a abrir: no existe modo de respaldo, a propósito.
# Se obtienen en la consola de Firebase -> Configuración del proyecto -> Tus apps.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://tu-proyecto.firebaseio.com
REACT_APP_FIREBASE_PROJECT_ID=tu-proyecto
REACT_APP_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=


# ------------------------------------------------------------------------------
# 2. MAPBOX — mapas y rutas
# ------------------------------------------------------------------------------
# [OBLIGATORIA] Sin ella no se dibuja el mapa ni se calculan rutas.
# Token público (pk.…) desde account.mapbox.com. Conviene restringirlo por
# dominio, porque viaja al navegador.

REACT_APP_MAPBOX_TOKEN=pk.tu_token_de_mapbox


# ------------------------------------------------------------------------------
# 3. SQL SERVER — conexión al ERP Profit Plus
# ------------------------------------------------------------------------------
# Todas [OBLIGATORIAS] para traer despachos del ERP. Solo servidor: nunca
# llegan al navegador.
#
# El usuario debe tener permisos SOLO sobre las tablas que hacen falta, no
# sobre la base completa. El script scripts/sql/SAREGO_Tracking_Instalacion.sql
# crea un usuario así.

SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=SARUSA_AD
SQLSERVER_USER=
SQLSERVER_PASSWORD=


# ------------------------------------------------------------------------------
# 4. RASTREO DE VEHÍCULOS — proveedor de GPS externo
# ------------------------------------------------------------------------------
# Opcionales. Sin ellas el seguimiento usa el GPS del teléfono del conductor,
# que es el modo normal de trabajo hoy.

# 'rest' (por defecto) o el modo que indique el proveedor
REACT_APP_TRACKING_MODE=rest

# URL base del servicio de rastreo
REACT_APP_TRACKING_BASE_URL=

# Cabecera y valor de autenticación que exige el proveedor.
# Ojo: al ser REACT_APP_ viajan al navegador. Si el proveedor entrega un
# secreto de verdad, hay que consumirlo desde el servidor, no desde aquí.
REACT_APP_TRACKING_AUTH_HEADER=
REACT_APP_TRACKING_AUTH_VALUE=

# Token del lado servidor para el mismo proveedor. Este no sale del servidor.
TRACKING_API_TOKEN=


# ------------------------------------------------------------------------------
# 5. PÁGINA DE ESTADO (/estado.html)
# ------------------------------------------------------------------------------
# Protege el informe de estado del proyecto, que muestra cifras del negocio
# (cuántos clientes, cuánto se despacha, en qué ciudades).
#
# Si se define, la página solo abre con  /estado.html?t=EL_VALOR
# Si se deja vacía, la página queda abierta a cualquiera con el enlace y lo
# advierte en pantalla.

ESTADO_TOKEN=


# ------------------------------------------------------------------------------
# 6. COMPORTAMIENTO DE LA APLICACIÓN
# ------------------------------------------------------------------------------
# Opcionales.

# Cargar pedidos automáticamente al abrir
REACT_APP_AUTOLOAD_PEDIDOS=true


# ------------------------------------------------------------------------------
# 7. CONSTRUCCIÓN
# ------------------------------------------------------------------------------
# En Vercel ya están puestas en vercel.json; aquí sirven para construir en local.

# No publicar el código fuente junto al sitio: con los mapas activos,
# /static/js/main.js.map devuelve todo el proyecto legible a cualquiera.
GENERATE_SOURCEMAP=false

# Que las advertencias no tumben la construcción
CI=false
DISABLE_ESLINT_PLUGIN=true
